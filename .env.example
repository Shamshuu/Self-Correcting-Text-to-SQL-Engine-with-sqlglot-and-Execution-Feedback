# Use "deterministic" to run without an external provider.
LLM_PROVIDER=deterministic
OPENAI_API_KEY=your_key_here
LLM_MODEL=gpt-4o-mini
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ecommerce_messy
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce_messy
MAX_ATTEMPTS=3
SEMANTIC_ROW_THRESHOLD=1000
